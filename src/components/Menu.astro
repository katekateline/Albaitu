---
import { Image } from 'astro:assets';
import takoyakiPlate from '../assets/takoyaki_plate.png';
import okonomiyaki from '../assets/okonomiyaki.png';
---

<section class="menu-section" id="menu" aria-labelledby="menu-title">
  <div class="menu-intro">
    <p class="eyebrow">The simple menu</p>
    <h2 id="menu-title">One bite,<br /><em>many memories.</em></h2>
    <p>Made to order and best enjoyed while the sauce is still glistening.</p>
  </div>
  <div class="menu-grid">
    <article class="menu-card menu-card-red">
      <div class="card-number">01</div>
      <div class="card-image card-image-takoyaki"><Image src={takoyakiPlate} alt="Golden takoyaki topped with sauce" widths={[360, 600]} sizes="(max-width: 720px) 90vw, 42vw" loading="lazy" /></div>
      <div class="card-detail"><div><p class="eyebrow">Signature</p><h3>Takoyaki</h3></div><span>From 20K</span></div>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </article>
    <article class="menu-card menu-card-cream">
      <div class="card-number">02</div>
      <div class="card-image card-image-oko"><Image src={okonomiyaki} alt="Okonomiyaki with Japanese toppings" widths={[360, 600]} sizes="(max-width: 720px) 90vw, 42vw" loading="lazy" /></div>
      <div class="card-detail"><div><p class="eyebrow">Comfort food</p><h3>Okonomiyaki</h3></div><span>From 25K</span></div>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </article>
  </div>
</section>
